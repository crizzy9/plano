<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/plano_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/plano_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/plano_widget_label"
    android:textColor="@color/plano_widget_secondary"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/plano_widget_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/plano_widget_no_flight"
    android:textColor="@color/plano_widget_primary"
    android:textSize="18sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/plano_widget_hint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="@string/plano_widget_hint"
    android:textColor="@color/plano_widget_secondary"
    android:textSize="12sp" />

  <ProgressBar
    android:id="@+id/plano_widget_progress"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="6dp"
    android:contentDescription="@string/plano_widget_progress"
    android:indeterminate="false"
    android:max="100"
    android:progressDrawable="@drawable/plano_widget_progress"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/plano_widget_countdown_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
      android:id="@+id/plano_widget_countdown_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/plano_widget_secondary"
      android:textSize="12sp" />

    <Chronometer
      android:id="@+id/plano_widget_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:maxLines="1"
      android:textColor="@color/plano_widget_primary"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
