# Compose starts a local demo by default. Set false when enabling live feeds.
PLANO_DEMO=true
PLANO_BIND_IP=127.0.0.1
PLANO_PORT=8080
PLANO_PUBLIC_URL=http://localhost:8080
PLANO_REFRESH_INTERVAL=60s
PLANO_LOG_LEVEL=info

# Optional enrollment code, 16 to 128 bytes. Prefer the file input.
PLANO_ENROLLMENT_CODE=
PLANO_ENROLLMENT_CODE_FILE=

# Live flight data. Set one AeroAPI key input when PLANO_DEMO=false.
PLANO_AEROAPI_KEY=
PLANO_AEROAPI_KEY_FILE=
PLANO_AEROALERTS_KEY_FILE=
PLANO_ADVISORY_INGRESS_KEY_FILE=
PLANO_FAA_NAS=true

# Optional advisory bridges. Use HTTPS and one token input per bridge.
PLANO_SWIM_URL=
PLANO_SWIM_TOKEN=
PLANO_SWIM_TOKEN_FILE=
PLANO_EUROCONTROL_URL=
PLANO_EUROCONTROL_TOKEN=
PLANO_EUROCONTROL_TOKEN_FILE=

# Optional readsb aircraft.json endpoint and unzipped FAA registry master file.
PLANO_ADSB_URL=
PLANO_FAA_REGISTRY_FILE=

# Optional airport route graph, booking index key, and learned delay estimates.
PLANO_AIRPORT_TRANSFERS_FILE=
PLANO_BOOKING_KEY_FILE=
PLANO_DELAY_MODEL_FILE=
PLANO_COLLECT_DELAY_SAMPLES=false

# Optional Apple push. Use the Plano iOS bundle ID and matching APNs environment.
PLANO_APNS_TEAM_ID=
PLANO_APNS_KEY_ID=
PLANO_APNS_BUNDLE_ID=
PLANO_APNS_PRIVATE_KEY_FILE=
PLANO_APNS_SANDBOX=false

# Optional Firebase push. Use the Firebase project built into the Android client.
PLANO_FCM_PROJECT_ID=
PLANO_FCM_SERVICE_ACCOUNT_FILE=
PLANO_FCM_BANDWIDTH_CONSTRAINED=false
